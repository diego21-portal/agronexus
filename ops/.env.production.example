# Copy to ops/.env.production and replace the example hostnames with your own.
# Production Django requires an external PostgreSQL server accepting SSL.
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=
DATABASE_URL=
ALLOWED_HOSTS=app.example.invalid,api.example.invalid
CORS_ALLOWED_ORIGINS=https://app.example.invalid
CSRF_TRUSTED_ORIGINS=https://app.example.invalid,https://api.example.invalid
DEFAULT_FROM_EMAIL=

APP_DOMAIN=app.example.invalid
API_DOMAIN=api.example.invalid
# Loopback is the default. Set 0.0.0.0 and ports 80/443 only for intentional publication.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
# Use a unique release tag to retain the previous images for rollback.
RELEASE_TAG=local
