# APP_DOMAIN and API_DOMAIN are substituted by the official Nginx entrypoint.
# The TLS certificate must cover both names. Never mount a private key into Git.
limit_req_zone $binary_remote_addr zone=auth_per_ip:10m rate=30r/m;

server {
    listen 80;
    server_name ${APP_DOMAIN} ${API_DOMAIN};
    return 308 https://$host:${HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl;
    server_name ${APP_DOMAIN};
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 20m;
    add_header X-Content-Type-Options nosniff always;

    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;

    location /api/v1/auth/ {
        limit_req zone=auth_per_ip burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://web:8000;
    }
    location /api/ {
        proxy_pass http://web:8000;
    }
    location = /health/ {
        proxy_pass http://web:8000;
    }
    location /media/products/documents/ {
        alias /srv/media/products/documents/;
        default_type application/octet-stream;
        add_header Content-Disposition "attachment" always;
        add_header X-Content-Type-Options nosniff always;
    }
    location /media/ {
        alias /srv/media/;
    }
    location /static/ {
        alias /srv/staticfiles/;
    }
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff always;
    }
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store";
        add_header X-Content-Type-Options nosniff always;
    }
}

# Django Admin and the React administration portal both use /admin/.
# A separate API origin preserves both routes without rewriting Django's links.
server {
    listen 443 ssl;
    server_name ${API_DOMAIN};
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 20m;
    add_header X-Content-Type-Options nosniff always;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;

    location /media/products/documents/ {
        alias /srv/media/products/documents/;
        default_type application/octet-stream;
        add_header Content-Disposition "attachment" always;
        add_header X-Content-Type-Options nosniff always;
    }
    location /media/ {
        alias /srv/media/;
    }
    location /static/ {
        alias /srv/staticfiles/;
    }
    location /api/v1/auth/ {
        limit_req zone=auth_per_ip burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://web:8000;
    }
    location / {
        proxy_pass http://web:8000;
    }
}
